# Database Configuration
MONGODB_URI=mongodb://localhost:27017/document-validator

# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_secret_key
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Document Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# Security
ENCRYPTION_KEY=change_this_to_a_32_character_secure_key
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug 